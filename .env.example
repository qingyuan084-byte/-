# ========================================================
# CinéMatic 通用环境变量模板
# 复制此文件为 .env 并填入实际值
# 环境专属覆盖: .env.development / .env.production
# ========================================================

# 运行环境: development | production
APP_ENV=development

# 智谱AI API 密钥（GLM 大模型 + 文本嵌入）
ZHIPU_API_KEY=your_key_here
ZHIPU_MODEL=glm-4-flash

# HuggingFace 镜像（国内网络可选）
HF_ENDPOINT=https://hf-mirror.com

# 文本嵌入后端: zhipu | local
EMBEDDING_PROVIDER=zhipu

# TMDB API 密钥（可选）
TMDB_API_KEY=your_key_here

# OpenAI API 密钥（可选，用于替代方案）
OPENAI_API_KEY=your_key_here

# DeepSeek 本地服务地址（可选）
DEEPSEEK_BASE_URL=http://localhost:11434

# PostgreSQL 数据库连接（可选，未配置时使用本地 CSV 文件）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
# 密码中包含 @ / : 等特殊字符时会自动 URL 编码
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_db

# Redis 缓存（可选，未配置时自动降级为无缓存直查模式）
# 格式: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379/0

# 缓存默认 TTL（秒），默认 3600
CACHE_TTL_SECONDS=3600

# 推荐器预计算相似度矩阵（默认 false，按需计算以节省内存）
# 设为 true 可加快单次推荐速度，但会额外占用约 17MB 内存（2065部电影）
RECOMMENDER_PRECOMPUTE=false

# FAISS 向量索引（默认 true，加速语义搜索）
# 设为 false 时强制使用 np.dot fallback
USE_FAISS_INDEX=true

# FAISS index 文件路径（相对于项目根目录或绝对路径）
FAISS_INDEX_PATH=data/features/movie_faiss.index
