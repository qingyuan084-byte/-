# ========================================================
# CinéMatic Railway 单容器部署 Dockerfile
# ========================================================
# 前端 (Node build) → 最终镜像 (Python + Nginx + 前端静态文件)
# Railway: 自动检测 Dockerfile，分配 PORT 环境变量
# ========================================================

# ── Stage 1: 前端构建 ─────────────────────────────────
FROM node:20-alpine AS frontend-build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ── Stage 2: 最终运行镜像 ──────────────────────────────
FROM python:3.11-slim-bookworm

# 系统依赖: scipy/faiss 编译 + nginx
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libopenblas-dev \
    gfortran \
    nginx \
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 项目代码
COPY . .

# 前端构建产物
COPY --from=frontend-build /app/dist /usr/share/nginx/html

# Nginx 配置模板 (启动时 envsubst 替换 PORT)
COPY nginx.railway.conf /etc/nginx/conf.d/default.conf.template

# 启动脚本
COPY start.railway.sh /start.sh
RUN chmod +x /start.sh

# 清理 nginx 默认配置
RUN rm -f /etc/nginx/sites-enabled/default

EXPOSE 80

CMD ["/start.sh"]
