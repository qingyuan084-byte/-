# ========================================================
# CinéMatic 开发环境配置
# 启动方式: APP_ENV=development python backend/app.py
# 或默认:   python backend/app.py  (development)
# ========================================================

# 服务端口
API_PORT=8002

# CORS — 开发环境允许所有来源
CORS_ORIGINS=*

# 日志级别
LOG_LEVEL=debug

# 前端开发服务器地址（用于代理）
FRONTEND_DEV_URL=http://localhost:3000
