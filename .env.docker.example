# ========================================================
# CinéMatic — Docker 环境变量模板
# ========================================================
# 用法: cp .env.docker.example .env.docker
#       编辑 .env.docker（必须填入 ZHIPU_API_KEY）
#       docker compose up -d
# ========================================================

# 运行环境
APP_ENV=docker

# API 端口（容器内）
API_PORT=8002

# ── 数据库 ──────────────────────────────────────────
# 主机名 postgres = docker-compose 服务名
DATABASE_URL=postgresql://movieuser:moviepass@postgres:5432/movie_db

# ── Redis 缓存 ──────────────────────────────────────
# 主机名 redis = docker-compose 服务名
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# ── 推荐器 ──────────────────────────────────────────
RECOMMENDER_PRECOMPUTE=false
USE_FAISS_INDEX=true
FAISS_INDEX_PATH=data/features/movie_faiss.index

# ── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── 阿里云 DashScope ────────────────────────────────
# ⚠️ 必须填入你的真实 API Key
ZHIPU_API_KEY=your_key_here
ZHIPU_MODEL=glm-4-flash

# ── 文本嵌入 ────────────────────────────────────────
EMBEDDING_PROVIDER=ZHIPU

# ── HuggingFace 镜像（国内网络可选） ──────────────────
# HF_ENDPOINT=https://hf-mirror.com
